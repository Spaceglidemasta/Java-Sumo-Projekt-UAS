<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.group_three.ui.controllers.CanvasController">
   <children>
      <StackPane fx:id="renderTargetBounds" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Canvas fx:id="worldStaticRenderTarget" height="200.0" onMouseClicked="#onMouseClicked" onMouseDragged="#onCanvasDragged" onMouseMoved="#onMouseMoved" onMousePressed="#onCanvasPressed" onScroll="#onScroll" scaleY="-1.0" width="200.0" />
            <Canvas fx:id="worldDynamicRenderTarget" height="200.0" onMouseClicked="#onMouseClicked" onMouseDragged="#onCanvasDragged" onMouseMoved="#onMouseMoved" onMousePressed="#onCanvasPressed" onScroll="#onScroll" scaleY="-1.0" width="200.0" />
            <HBox alignment="TOP_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" spacing="8.0" StackPane.alignment="TOP_RIGHT">
               <children>
                  <CheckBox mnemonicParsing="false" text="High Contrast" HBox.hgrow="NEVER" />
                  <CheckBox mnemonicParsing="false" selected="true" text="(Poly) Environment" HBox.hgrow="NEVER" />
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
            <AnchorPane maxHeight="64.0" maxWidth="64.0" minHeight="64.0" minWidth="64.0" prefHeight="64.0" prefWidth="64.0" StackPane.alignment="TOP_LEFT">
               <StackPane.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </StackPane.margin>
               <children>
                  <Circle fill="#00000033" radius="32.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="2.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                  <AnchorPane maxHeight="64.0" maxWidth="64.0" minHeight="64.0" minWidth="64.0" prefHeight="64.0" prefWidth="64.0">
                     <children>
                        <Line endY="4.0" layoutX="32.0" startY="32.0" stroke="WHITE" strokeWidth="3.0" />
                     </children>
                  </AnchorPane>
               </children>
            </AnchorPane>
         </children>
      </StackPane>
   </children>
</AnchorPane>
