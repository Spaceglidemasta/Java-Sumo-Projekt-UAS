<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.group_three.ui.controllers.CanvasController">
   <children>
      <StackPane fx:id="renderTargetBounds" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Canvas fx:id="worldStaticRenderTarget" height="200.0" onMouseClicked="#onMouseClicked" onMouseDragged="#onCanvasDragged" onMouseMoved="#onMouseMoved" onMousePressed="#onCanvasPressed" onScroll="#onScroll" width="200.0" />
            <Canvas fx:id="worldDynamicRenderTarget" height="200.0" layoutX="10.0" layoutY="10.0" onMouseClicked="#onMouseClicked" onMouseDragged="#onCanvasDragged" onMouseMoved="#onMouseMoved" onMousePressed="#onCanvasPressed" onScroll="#onScroll" width="200.0" />
            <Button mnemonicParsing="false" opacity="0.0" text="Button" StackPane.alignment="TOP_CENTER" />
            <Button mnemonicParsing="false" opacity="0.0" text="Button" StackPane.alignment="BOTTOM_CENTER" />
            <Button mnemonicParsing="false" opacity="0.0" text="Button" StackPane.alignment="CENTER_LEFT" />
            <Button mnemonicParsing="false" opacity="0.0" text="Button" StackPane.alignment="CENTER_RIGHT" />
         </children>
      </StackPane>
   </children>
</AnchorPane>
