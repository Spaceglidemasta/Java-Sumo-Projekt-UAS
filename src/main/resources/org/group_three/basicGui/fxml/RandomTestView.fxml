<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button mnemonicParsing="false" text="Button" StackPane.alignment="TOP_CENTER" />
            <Button mnemonicParsing="false" text="Button" StackPane.alignment="BOTTOM_CENTER" />
            <Button mnemonicParsing="false" text="Button" StackPane.alignment="CENTER_LEFT" />
            <Button mnemonicParsing="false" text="Button" StackPane.alignment="CENTER_RIGHT" />
         </children>
      </StackPane>
   </children>
</AnchorPane>
