<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.group_three</groupId>
	<artifactId>JavaProjectWiSe2526</artifactId>
	<version>1.0-SNAPSHOT</version>

	<properties>
		<maven.compiler.source>25</maven.compiler.source>
		<maven.compiler.target>25</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<javafx.version>25.0.1</javafx.version> <!-- Set JavaFX-Version to 25.0.1 -->
		<mainClassPath>org.group_three.Main</mainClassPath> <!-- Set the main class path -->
	</properties>

	<!-- Repository, wo Maven die SUMO-Libs findet -->
	<repositories>
		<repository>
			<id>eclipse-sumo</id>
			<name>Public Eclipse SUMO Nexus</name>
			<url>https://repo.eclipse.org/content/repositories/sumo-releases/</url>
		</repository>
	</repositories>

	<!-- Dependencies (SUMO Java-Libraries) -->
	<dependencies>
		<dependency>
			<groupId>org.eclipse.sumo</groupId>
			<artifactId>libsumo</artifactId>
			<version>1.24.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.sumo</groupId>
			<artifactId>libtraci</artifactId>
			<version>1.24.0</version>
		</dependency>

		<!-- Add JavaFX -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-fxml</artifactId>
			<version>${javafx.version}</version>
		</dependency>


        <dependency>
            <groupId>org.eclipse.sumo</groupId>
            <artifactId>traas</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/TraaS.jar</systemPath>
        </dependency>

	</dependencies>

	<build>
		<plugins>

			<!-- Compiler Plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<source>25</source> <!-- oder 21, je nach JDK -->
					<target>25</target>
				</configuration>
			</plugin>

			<!-- Exec Plugin -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.2</version>
				<configuration>
					<mainClass>${mainClassPath}</mainClass>
				</configuration>
			</plugin>

			<!-- JavaFX Maven Plugin -->
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>0.0.8</version>
				<configuration>
					<mainClass>${mainClassPath}</mainClass>
				</configuration>
			</plugin>

		</plugins>
	</build>
</project>


